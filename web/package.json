{
  "name": "kyc-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:check": "node scripts/build-check.mjs",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "smoke:audit": "node --experimental-strip-types --no-warnings scripts/smoke-audit.ts",
    "enqueue": "node --experimental-strip-types --no-warnings scripts/enqueue-demo-jobs.ts",
    "webhook": "node --experimental-strip-types --no-warnings scripts/replay-webhook.ts"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "pg": "8.13.1",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/pg": "8.11.10"
  }
}
