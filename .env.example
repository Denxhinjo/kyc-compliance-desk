# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored.
# This single root .env is read by docker-compose, /web and /worker.
# ---------------------------------------------------------------------------

# --- Postgres (used by docker-compose to create the container) -------------
POSTGRES_USER=kyc
POSTGRES_PASSWORD=kyc_local_dev_only
POSTGRES_DB=kyc
# Host port. The container always listens on 5432 internally; this is the port
# exposed on your machine. 5434 because 5432 and 5433 are already taken on this machine.
POSTGRES_HOST_PORT=5434

# --- Connection string (used by /web and /worker) --------------------------
# Must match the three POSTGRES_* values above and POSTGRES_HOST_PORT.
DATABASE_URL=postgresql://kyc:kyc_local_dev_only@localhost:5434/kyc

# --- Worker ----------------------------------------------------------------
# Seconds between heartbeats.
WORKER_HEARTBEAT_SECONDS=10

# --- Sumsub (Phase 3 — identity verification vendor sandbox) ---------------
# Not used yet. Left here so .env.example stays the full inventory.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_BASE_URL=https://api.sumsub.com

# --- Staff login (Phase 6 — compliance review desk) ------------------------
# Not used yet.
STAFF_EMAIL=
STAFF_PASSWORD=
SESSION_SECRET=
