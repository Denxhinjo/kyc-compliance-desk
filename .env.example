# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored.
# This single root .env is read by docker-compose, /web and /worker.
# ---------------------------------------------------------------------------

# --- Postgres (used by docker-compose to create the container) -------------
POSTGRES_USER=kyc
POSTGRES_PASSWORD=kyc_local_dev_only
POSTGRES_DB=kyc
# Host port. The container always listens on 5432 internally; this is the port
# exposed on your machine. 5434 because 5432 and 5433 are already taken on this machine.
POSTGRES_HOST_PORT=5434

# --- Connection string (used by /web and /worker) --------------------------
# Must match the three POSTGRES_* values above and POSTGRES_HOST_PORT.
DATABASE_URL=postgresql://kyc:kyc_local_dev_only@localhost:5434/kyc

# --- Worker ----------------------------------------------------------------
# Identifies this worker in jobs.locked_by. Defaults to hostname:pid, which is
# what you want when running several workers locally.
WORKER_ID=
# How long to wait before polling again when the queue is empty. This is the
# price of polling instead of LISTEN/NOTIFY: a job can wait this long unnoticed.
WORKER_POLL_SECONDS=1

# --- Job queue -------------------------------------------------------------
# Retry schedule: base * 2^(attempts-1), capped, with jitter.
# 5s, 10s, 20s, 40s, 80s ...
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_CAP_SECONDS=3600
# Attempts before a job is parked for a human to look at.
JOB_MAX_ATTEMPTS=5
# A job 'running' longer than this is presumed abandoned and reclaimed. MUST be
# longer than the slowest legitimate job, or work still in progress gets
# reclaimed and run twice.
JOB_STALE_SECONDS=300
JOB_REAP_INTERVAL_SECONDS=60

# --- Sumsub (Phase 3 — identity verification vendor sandbox) ---------------
# Not used yet. Left here so .env.example stays the full inventory.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_BASE_URL=https://api.sumsub.com

# --- Staff login (Phase 6 — compliance review desk) ------------------------
# Not used yet.
STAFF_EMAIL=
STAFF_PASSWORD=
SESSION_SECRET=
